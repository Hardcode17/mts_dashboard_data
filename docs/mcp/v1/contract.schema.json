        {
          "type": "object",
          "properties": {
            "contractVersion": {
              "const": "1.0.0"
            },
            "ok": {
              "const": true
            },
            "data": {
              "type": "object",
              "properties": {
                "events": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/event"
                  },
                  "maxItems": 100
                },
                "nextCursor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "hasMore": {
                  "type": "boolean"
                }
              },
              "required": [
