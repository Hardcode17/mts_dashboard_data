    "find_resolver_groupsInput": {
      "type": "object",
      "properties": {
        "incidentId": {
          "type": "string",
          "pattern": "^INC[0-9]{6,18}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "incidentId"
      ],
      "additionalProperties": false
    },
    "find_resolver_groupsOutput": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contractVersion": {
              "const": "1.0.0"
            },
            "ok": {
              "const": true
            },
            "data": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/group"
                  },
                  "maxItems": 100
                },
                "nextCursor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "recommendedGroupId": {
                  "anyOf": [
                    {
